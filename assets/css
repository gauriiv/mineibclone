/* ===================================================
    */

:root {
  --navy-deep: #0b1220;
  --navy-mid: #121b30;
  --navy-line: #24304a;
  --orange: #ff6b35;
  --amber: #ffb86b;
  --text-main: #edeff5;
  --text-muted: #8892a6;
  --radius: 10px;

  --font-display: 'Space Grotesk', sans-serif;
  --font-body: 'Inter', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--navy-deep);
  color: var(--text-main);
  font-family: var(--font-body);
  line-height: 1.5;
}

a { text-decoration: none; color: inherit; }

/* ---------------- HEADER ---------------- */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 6%;
  background: rgba(11, 18, 32, 0.85);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--navy-line);
}

.logo {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  display: flex;
  align-items: baseline;
  gap: 2px;
}

.logo span {
  color: var(--orange);
}

.main-nav ul {
  display: flex;
  list-style: none;
  gap: 36px;
}

.main-nav a {
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--text-muted);
  position: relative;
  transition: color 0.25s ease;
}

.main-nav a::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -6px;
  width: 0;
  height: 2px;
  background: var(--orange);
  transition: width 0.25s ease;
}

.main-nav a:hover {
  color: var(--text-main);
}

.main-nav a:hover::after {
  width: 100%;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.btn-cta {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.9rem;
  padding: 10px 22px;
  border-radius: var(--radius);
  background: var(--orange);
  color: #0b1220;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(255, 107, 53, 0.35);
}

.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
}

.nav-toggle span {
  width: 24px;
  height: 2px;
  background: var(--text-main);
}

/* ---------------- HERO ---------------- */

.hero {
  display: grid;
  grid-template-columns: 1fr;
  align-items: center;
  gap: 60px;
  padding: 100px 6% 110px;
  max-width: 800px;
  margin: 0 auto;
  position: relative;
  overflow: hidden;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--amber);
  border: 1px solid var(--navy-line);
  padding: 6px 14px;
  border-radius: 999px;
  margin-bottom: 24px;
}

.hero-eyebrow::before {
  content: '';
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--orange);
  box-shadow: 0 0 8px var(--orange);
}

.hero-content h1 {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 4.2vw, 3.6rem);
  line-height: 1.12;
  font-weight: 700;
  margin-bottom: 22px;
  letter-spacing: -0.5px;
}

.hero-content h1 .highlight {
  color: var(--orange);
}

.hero-content p {
  font-size: 1.05rem;
  color: var(--text-muted);
  max-width: 480px;
  margin-bottom: 34px;
}

.hero-buttons {
  display: flex;
  gap: 16px;
  margin-bottom: 46px;
}

.btn-outline {
  font-weight: 600;
  font-size: 0.9rem;
  padding: 12px 26px;
  border-radius: var(--radius);
  border: 1px solid var(--navy-line);
  color: var(--text-main);
  transition: border-color 0.25s ease, background 0.25s ease;
}

.btn-outline:hover {
  border-color: var(--orange);
  background: rgba(255, 107, 53, 0.08);
}

.hero-buttons .btn-cta {
  padding: 12px 26px;
}

.hero-stats {
  display: flex;
  gap: 40px;
}

.hero-stats div {
  border-left: 2px solid var(--navy-line);
  padding-left: 14px;
}

.hero-stats strong {
  display: block;
  font-family: var(--font-display);
  font-size: 1.5rem;
  color: var(--text-main);
}

.hero-stats span {
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* --- Signature element: animated code window --- */

.code-window {
  background: var(--navy-mid);
  border: 1px solid var(--navy-line);
  border-radius: 12px;
  box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
  overflow: hidden;
  font-family: var(--font-mono);
  font-size: 0.85rem;
}

.code-window-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  background: #0e1526;
  border-bottom: 1px solid var(--navy-line);
}

.code-window-bar .dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.dot.red { background: #ff5f56; }
.dot.yellow { background: #ffbd2e; }
.dot.green { background: #27c93f; }

.code-window-bar .file-name {
  margin-left: 10px;
  color: var(--text-muted);
  font-size: 0.75rem;
}

.code-window-body {
  padding: 22px 20px;
  color: #cbd5e1;
  min-height: 220px;
}

.code-window-body .c-comment { color: #6b7688; }
.code-window-body .c-key { color: var(--amber); }
.code-window-body .c-string { color: #7ee787; }
.code-window-body .c-tag { color: var(--orange); }

.type-cursor {
  display: inline-block;
  width: 7px;
  height: 1em;
  background: var(--orange);
  vertical-align: text-bottom;
  animation: blink 0.9s steps(1) infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

/* ---------------- RESPONSIVE ---------------- */

@media (max-width: 900px) {
  .main-nav, .header-actions .btn-cta { display: none; }
  .nav-toggle { display: flex; }

  .hero {
    grid-template-columns: 1fr;
    padding: 60px 6% 60px;
    text-align: left;
  }

  .hero-stats { flex-wrap: wrap; row-gap: 20px; }
}

@media (prefers-reduced-motion: reduce) {
  .type-cursor { animation: none; }
}

